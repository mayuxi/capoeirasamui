---
const { title, description, lang = "en", dir = "ltr" } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://capoeirasamui.com/images/logo.png"
    />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://capoeirasamui.com/images/logo.png"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts: Cormorant Garamond (display) + Jost (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --sand: #f5f0e8;
        --ink: #1a1612;
        --terra: #8b3a1f;
        --gold: #c8963e;
        --mist: #e8e2d8;
        --terra-light: #f0e8e4;

        --font-display: "Cormorant Garamond", Georgia, serif;
        --font-body: "Jost", system-ui, sans-serif;

        --max-w: 720px;
        --gap: clamp(2rem, 6vw, 5rem);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--sand);
        color: var(--ink);
        font-family: var(--font-body);
        font-weight: 300;
        font-size: 1.05rem;
        line-height: 1.75;
      }

      /* RTL support */
      [dir="rtl"] {
        font-family: var(--font-body);
      }

      a {
        color: var(--terra);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }
      a:hover {
        border-color: var(--terra);
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.2;
      }

      /* --- NAV --- */
      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--sand);
        border-bottom: 1px solid var(--mist);
        padding: 0.9rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .nav-logo img {
        height: 48px;
        width: auto;
        display: block;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        list-style: none;
        flex-wrap: wrap;
      }

      .nav-links a {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink);
        border-bottom: none;
        opacity: 0.6;
        transition: opacity 0.2s;
      }
      .nav-links a:hover,
      .nav-links a.active {
        opacity: 1;
        color: var(--terra);
      }

      .nav-sep {
        width: 1px;
        height: 16px;
        background: var(--mist);
        flex-shrink: 0;
      }

      .nav-manifesto {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        color: var(--ink) !important;
        opacity: 0.8 !important;
      }

      /* --- SECTIONS --- */
      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: var(--gap) 0;
        border-bottom: 1px solid var(--mist);
      }
      section:last-child {
        border-bottom: none;
      }

      /* --- HERO --- */
      .hero {
        padding: clamp(3rem, 10vw, 7rem) 0 var(--gap);
        text-align: center;
      }

      .hero h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        color: var(--terra);
        margin-bottom: 1.5rem;
        font-style: italic;
      }

      .hero p {
        max-width: 600px;
        margin: 0 auto 2rem;
        opacity: 0.85;
      }

      .btn {
        display: inline-block;
        padding: 0.65rem 1.8rem;
        background: var(--terra);
        color: var(--sand) !important;
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: none;
        border-bottom: none !important;
        transition: background 0.2s;
      }
      .btn:hover {
        background: var(--ink);
      }

      /* --- SECTION HEADINGS --- */
      .section-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.6rem;
      }

      h2 {
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        color: var(--ink);
        margin-bottom: 1.2rem;
      }

      /* --- SCHEDULE --- */
      .schedule-card {
        background: var(--terra-light);
        border-left: 3px solid var(--terra);
        padding: 1.4rem 1.6rem;
        margin: 1.5rem 0;
      }
      [dir="rtl"] .schedule-card {
        border-left: none;
        border-right: 3px solid var(--terra);
      }

      .schedule-card strong {
        display: block;
        font-family: var(--font-display);
        font-size: 1.4rem;
        color: var(--terra);
        margin-bottom: 0.2rem;
      }

      .map-link {
        display: block;
        margin-top: 1.5rem;
        border-bottom: none !important;
      }
      .map-link img {
        width: 100%;
        border-radius: 2px;
        display: block;
        transition: opacity 0.2s;
      }
      .map-link:hover img {
        opacity: 0.85;
      }

      /* --- CONTACT --- */
      .contact-links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1rem;
      }
      .contact-links a {
        font-weight: 500;
        font-size: 0.95rem;
      }

      /* --- MANIFESTO --- */
      .manifesto-body {
        margin-bottom: 2rem;
      }

      .beliefs {
        display: grid;
        gap: 1.5rem;
        margin: 2rem 0;
      }

      .belief {
        padding: 1.2rem 1.4rem;
        border: 1px solid var(--mist);
        background: white;
      }

      .belief-num {
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--mist);
        line-height: 1;
        margin-bottom: 0.3rem;
      }

      .belief h3 {
        font-size: 1.05rem;
        margin-bottom: 0.5rem;
        color: var(--terra);
      }

      .belief p {
        font-size: 0.95rem;
        opacity: 0.85;
      }

      .axe {
        font-family: var(--font-display);
        font-size: 2rem;
        font-style: italic;
        color: var(--terra);
        margin-top: 1.5rem;
      }

      /* --- FRIENDS --- */
      .friends-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-top: 1rem;
      }
      .friends-list a {
        font-weight: 400;
      }

      /* --- FOOTER --- */
      footer {
        padding: 2rem 1.5rem;
        text-align: center;
        font-size: 0.8rem;
        opacity: 0.5;
        border-top: 1px solid var(--mist);
      }
      footer a {
        color: inherit;
        border-bottom: none;
      }
      footer a:hover {
        opacity: 0.8;
      }

      /* Fade-in on load */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero {
        animation: fadeUp 0.7s ease both;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
